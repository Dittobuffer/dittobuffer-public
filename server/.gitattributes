* text=auto eol=lf
*.py  text
*.js  text
*.html text
*.css text
*.md  text
*.json text
*.toml text
*.yml text
*.yaml text
*.sh  text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
# Large binaries live in Git LFS.
*.apk  filter=lfs diff=lfs merge=lfs -text
*.so   filter=lfs diff=lfs merge=lfs -text
*.jks  filter=lfs diff=lfs merge=lfs -text
*.sqlite3 filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text
apk/built/*.apk filter=lfs diff=lfs merge=lfs -text
apk/patched/*.apk filter=lfs diff=lfs merge=lfs -text
artifacts/*.apk filter=lfs diff=lfs merge=lfs -text
